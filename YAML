resilience4j:
  retry:
    instances:
      productServiceRetry:
        max-attempts: 3
        wait-duration: 2s
      productServiceRateLimiter:
        limit-for-period: 5
        limit-refresh-period: 20s
        timeout-duration: 0s
      customerServiceRetry:
        max-attempts: 3
        wait-duration: 2s
      customerServiceRateLimiter:
        limit-for-period: 5
        limit-refresh-period: 20s
        timeout-duration: 0s

logging:
  level:
    io.github.resilience4j.retry: DEBUG
