resilience4j:
  retry:
    instances:
      productServiceRetry:
        max-attempts: 3
        wait-duration: 2s

      customerServiceRetry:
        max-attempts: 3
        wait-duration: 2s

  ratelimiter:
    instances:
      productServiceRateLimiter:
        limit-for-period: 2
        limit-refresh-period: 30s
        timeout-duration: 0s

      customerServiceRateLimiter:
        limit-for-period: 2
        limit-refresh-period: 30s
        timeout-duration: 0s
  bulkhead:
    instances:
      customerServiceBulkhead:
        max-concurrent-calls: 2
        max-wait-duration: 0s

logging:
  level:
    io.github.resilience4j.retry: DEBUG
    io.github.resilience4j.ratelimiter: DEBUG
