circuitbreaker:
    instances:
      customerservice:
        ignore-exceptions:
          - com.example.OrderService.GlobalExceptionHandler.CustomerNotFoundException
      productservice:
        ignore-exceptions:
        - com.example.OrderService.GlobalExceptionHandler.ProductNotFoundException

resilience4j:
  retry:
    instances:
      productServiceRetry:
        max-attempts: 3
        wait-duration: 2s
          - com.example.OrderService.GlobalExceptionHandler.ProductNotFoundException

      customerServiceRetry:
        max-attempts: 3
        wait-duration: 2s
        ignore-exceptions:
          - com.example.OrderService.GlobalExceptionHandler.CustomerNotFoundException

ratelimiter:
    instances:
      productServiceRateLimiter:
        limit-for-period: 2
        limit-refresh-period: 30s
        timeout-duration: 0s

      customerServiceRateLimiter:
        limit-for-period: 2
        limit-refresh-period: 30s
        timeout-duration: 0s
bulkhead:
    instances:
      customerServiceBulkhead:
        max-concurrent-calls: 2
        max-wait-duration: 0s

timelimiter:
    instances:
      customerServiceTimeLimiter:
        timeout-duration: 3s
        cancel-running-future: true

logging:
  level:
    io.github.resilience4j.retry: DEBUG
    io.github.resilience4j.ratelimiter: DEBUG
